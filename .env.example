# Copy to .env.local and fill in. Never commit .env.local.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Secret: bypasses row-level security. Server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Secret used to turn PINs into Supabase passwords. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it later locks every existing reader out (they'd need to reset their PIN).
PIN_PEPPER=

# Optional. Used to build links in emails. Defaults to the request's origin.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Enables AI-suggested chapter lists (and, later, recaps). Without it the app
# works fully; readers set up chapters themselves. Get a key at console.anthropic.com.
# ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5; claude-haiku-5-5 is much cheaper.
# ANTHROPIC_MODEL=claude-haiku-5-5
